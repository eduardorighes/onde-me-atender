# Copie este arquivo para .env e preencha com a sua chave.
ANTHROPIC_API_KEY=

# Modelo usado pelo agente (padrão: claude-sonnet-5-5; opção econômica: claude-haiku-5-5)
CLAUDE_MODELO=claude-sonnet-5-5

# Esforço do modelo: low | medium | high (menos esforço = mais rápido e mais barato)
CLAUDE_ESFORCO=medium

# Endereço do servidor MCP local
MCP_URL=http://localhost:8000/mcp
